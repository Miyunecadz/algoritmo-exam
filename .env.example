# Application database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/billing
# Database used by the e2e suite (created and migrated by the test harness)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/billing_test
PORT=3000

# LLM provider for the reconciliation slice: stub | anthropic
LLM_PROVIDER=stub
# Leave empty. Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_MS=3000
